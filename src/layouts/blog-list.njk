---
pagination:
  data: collections.posts
  size: 10
  alias: posts
permalink: "blog/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
eleventyComputed:
  title: "Blog – Silvia Genevro"
---
<!doctype html><html lang="it">
<head>
  <meta charset="utf-8">
  <title>Blog – Silvia Genevro</title>
  <meta name="description" content="Articoli su mindfulness, MBSR e pratiche guidate.">
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
<main class="section">
  <h1>Blog</h1>
  <ul class="cards">
  {% for post in posts %}
    <li class="card" style="background:#fff;color:#24323a;">
      <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
      <p class="muted">{{ post.date | date("dd LLL yyyy") }}</p>
      <p>{{ post.data.description or post.templateContent | striptags | truncate(160) }}</p>
      <a class="btn" href="{{ post.url }}">Leggi</a>
    </li>
  {% endfor %}
  </ul>

  {% if pagination.href.next or pagination.href.previous %}
    <p style="margin-top:20px;">
      {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">← Pagina precedente</a>{% endif %}
      {% if pagination.href.previous and pagination.href.next %} &nbsp;|&nbsp; {% endif %}
      {% if pagination.href.next %}<a href="{{ pagination.href.next }}">Pagina successiva →</a>{% endif %}
    </p>
  {% endif %}
</main>
</body></html>
